APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=getnet-multi-agent-support-v2

# Optional Langfuse tracing (opt-in; see docs/LLM_OBSERVABILITY.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false

# Optional Knowledge Agent generation via Gemini (see README.md).
# Leave unset to use the deterministic extractive fallback — the app stays fully
# functional, it just quotes the retrieved source instead of paraphrasing it.
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-2.5-flash

# Optional general-purpose web search via Tavily (see README.md).
# Leave unset to make the Knowledge Agent report current/external questions
# (weather, exchange rates, news) as unavailable instead of guessing. Only the
# free-text question is ever sent to Tavily — never customer data.
# TAVILY_API_KEY=
