APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=getnet-multi-agent-support-v2

# Generation provider: "gemini" (default) or "gateway".
LLM_PROVIDER=gemini

# Direct Gemini generation and optional semantic-embeddings retriever.
# Leave unset in gateway mode unless RETRIEVER=semantic_embeddings.
GOOGLE_API_KEY=

# Governed LLM Gateway generation. The service still owns business scope,
# routing between support agents, evidence gates, and tool execution. The
# gateway owns model authorization/selection and provider retry/fallback.
# GATEWAY_URL=https://gateway.example.com
# GATEWAY_API_KEY=
GATEWAY_WORKLOAD=support.getnet.answer
GATEWAY_RISK_LEVEL=low
GATEWAY_DATA_CLASSIFICATION=public

# Web search provider (Tavily). Leave unset to run degraded: out-of-corpus
# questions escalate to a human instead of searching the web.
TAVILY_API_KEY=

# Retriever mode: "lexical" (default), "semantic" (a local, offline,
# deterministic vectorizer, no key needed), or "semantic_embeddings" (real
# Gemini text-embedding-004, requires GOOGLE_API_KEY even when generation uses
# the gateway, and falls back to "semantic" if the key is missing or the
# startup embedding call fails; see README).
RETRIEVER=lexical

# Evidence gate thresholds (REQ-09), calibrated against
# tests/acceptance/eval_dataset.json. Do not raise without re-validating the
# eval dataset first.
SCORE_MIN=0.1
COVERAGE_MIN=0.55

# Router LLM tie-break confidence floor (REQ-07).
ROUTER_CONFIDENCE_MIN=0.6

# Timeout for LLM and web-search calls, in seconds (REQ-07 caps the router's
# LLM tie-break at 2s).
LLM_TIMEOUT_SECONDS=2.0

# Optional Langfuse tracing (opt-in; see docs/LLM_OBSERVABILITY.md).
# Leave unset to keep tracing disabled. Requires `uv sync --extra tracing`.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_CAPTURE_CONTENT=false
